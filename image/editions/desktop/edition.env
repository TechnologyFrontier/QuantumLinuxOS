# Desktop edition overrides (QOS-DT 2.1).  Sourced by config.env when
# QOS_EDITION=desktop; values given in the environment still win.
: "${QOS_PRODUCT_ID:=quantumos-desktop}"
: "${ROOT_SLOT_SIZE_MIB:=12288}"
: "${ROOT_IMAGE_SIZE_MIB:=6144}"   # measured content 3.0 GiB (0.2.0); bundles carry the full image
: "${DISK_SIZE_MIB:=65536}"
