# QuantumOS image build parameters (QOS-BD 1章・3章)
# Candidate values — the concrete distribution release, kernel series and
# evaluation hardware/virtualisation are to be fixed before evaluation.
QOS_PRODUCT_ID="${QOS_PRODUCT_ID:-quantumos}"
QOS_VERSION="${QOS_VERSION:-0.1.0}"
QOS_ARCH="${QOS_ARCH:-x86_64}"
DEBIAN_SUITE="${DEBIAN_SUITE:-trixie}"
DEBIAN_MIRROR="${DEBIAN_MIRROR:-http://deb.debian.org/debian}"

# Disk layout (GPT) for a >= 32 GiB dedicated disk
ESP_SIZE_MIB="${ESP_SIZE_MIB:-1024}"
ROOT_SLOT_SIZE_MIB="${ROOT_SLOT_SIZE_MIB:-6144}"
ROOT_IMAGE_SIZE_MIB="${ROOT_IMAGE_SIZE_MIB:-3072}"   # must be <= ROOT_SLOT_SIZE_MIB
DISK_SIZE_MIB="${DISK_SIZE_MIB:-32768}"          # raw image size; state partition takes the rest

KERNEL_CMDLINE_EXTRA="${KERNEL_CMDLINE_EXTRA:-quiet console=tty1 console=ttyS0,115200}"
